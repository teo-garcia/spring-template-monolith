<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <springProperty scope="context" name="serviceName" source="app.otel-service-name" defaultValue="spring-template-monolith"/>

  <springProfile name="!production &amp; !prod">
    <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%thread] %logger{36} [%X{requestId:-}] - %msg%n</pattern>
      </encoder>
    </appender>
    <logger name="com.teogarcia.springmonolith" level="${LOG_LEVEL:-INFO}"/>
    <root level="WARN">
      <appender-ref ref="CONSOLE_PLAIN"/>
    </root>
  </springProfile>

  <springProfile name="production,prod">
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeMdcKeyName>requestId</includeMdcKeyName>
        <includeMdcKeyName>method</includeMdcKeyName>
        <includeMdcKeyName>path</includeMdcKeyName>
        <customFields>{"service":"${serviceName}"}</customFields>
      </encoder>
    </appender>
    <logger name="com.teogarcia.springmonolith" level="${LOG_LEVEL:-INFO}"/>
    <root level="WARN">
      <appender-ref ref="CONSOLE_JSON"/>
    </root>
  </springProfile>

  <logger name="org.hibernate.SQL" level="WARN"/>
  <logger name="org.flywaydb" level="INFO"/>
</configuration>
