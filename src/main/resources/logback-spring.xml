<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdcKeyName>requestId</includeMdcKeyName>
      <includeMdcKeyName>method</includeMdcKeyName>
      <includeMdcKeyName>path</includeMdcKeyName>
      <customFields>{"service":"${app.otel-service-name:-spring-template-monolith}"}</customFields>
    </encoder>
  </appender>

  <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%thread] %logger{36} [%X{requestId:-}] - %msg%n</pattern>
    </encoder>
  </appender>

  <springProfile name="default">
    <root level="${LOG_LEVEL:-INFO}">
      <appender-ref ref="CONSOLE_PLAIN"/>
    </root>
  </springProfile>

  <springProfile name="production,prod">
    <root level="${LOG_LEVEL:-INFO}">
      <appender-ref ref="CONSOLE_JSON"/>
    </root>
  </springProfile>

  <logger name="org.hibernate.SQL" level="WARN"/>
  <logger name="org.flywaydb" level="INFO"/>
</configuration>
